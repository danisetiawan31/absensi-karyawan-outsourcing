DATABASE_URL="postgresql://user:password@localhost:5432/absensi_db?schema=public"
JWT_SECRET="your_jwt_secret_here"
RESEND_API_KEY=
FACE_SERVICE_URL="http://localhost:8000"
FACE_SERVICE_TIMEOUT_MS="60000"
FACE_MATCH_DISTANCE_THRESHOLD=0.40 # Ini COSINE DISTANCE (1 - cosine similarity), BUKAN similarity — semakin KECIL nilainya semakin mirip. Perbandingan yang benar: (1 - cosineSimilarity(a,b)) <= FACE_MATCH_DISTANCE_THRESHOLD berarti MATCH.