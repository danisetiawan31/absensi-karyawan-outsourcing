{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_HOST",
    "REDIS_PORT",
    "JWT_SECRET",
    "JWT_REFRESH_SECRET",
    "PORT",
    "TZ",
    "SKIP_FACE_VERIFICATION",
    "FACE_SERVICE_TIMEOUT_MS",
    "RESEND_API_KEY",
    "FACE_SERVICE_URL"
  ],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_HOST",
    "REDIS_PORT",
    "JWT_SECRET",
    "JWT_REFRESH_SECRET",
    "PORT",
    "TZ",
    "SKIP_FACE_VERIFICATION",
    "FACE_SERVICE_TIMEOUT_MS",
    "RESEND_API_KEY",
    "FACE_SERVICE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
